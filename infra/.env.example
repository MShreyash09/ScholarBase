# Copy this file to infra/.env before running `docker compose up` from infra/.
# These vars only drive the infra containers (Postgres, MinIO). The backend
# and frontend read their own env files (see backend/.env.example and
# frontend/.env.example) since they run natively on the host in local dev.

# --- Postgres ---
POSTGRES_USER=scholarbase
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scholarbase
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_ROOT_USER=scholarbase
MINIO_ROOT_PASSWORD=change_me_min_8_chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_PAPERS=papers
MINIO_BUCKET_NOTES=notes
MINIO_BUCKET_AVATARS=avatars

# --- Production only (docker-compose.prod.yml) ---
ACME_EMAIL=you@youruniversity.edu.in
API_DOMAIN=api.scholarbase.example
APP_DOMAIN=scholarbase.example
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ALLOWED_EMAIL_DOMAINS=youruniversity.edu.in
