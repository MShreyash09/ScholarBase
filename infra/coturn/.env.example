# Copy to infra/coturn/.env on the VM running coturn (not the backend host).
#
# TURN_STATIC_AUTH_SECRET must be the exact same value as the backend's
# TURN_STATIC_AUTH_SECRET (set on Render/wherever the backend runs) — it's how
# the two sides agree on credentials without ever transmitting them to each
# other. Generate one with:
#   openssl rand -hex 32

TURN_REALM=turn.yourdomain.example
TURN_PUBLIC_IP=203.0.113.10
TURN_STATIC_AUTH_SECRET=
