# Copy to frontend/.env for local (native, non-Docker) development.
VITE_API_BASE_URL=http://localhost:3000

# ICE servers are NOT configured here any more. The browser fetches them from
# GET /api/study-rooms/ice-servers at call time, because TURN credentials are
# minted with an expiry and cannot live in a build-time variable. Configure
# STUN_URLS / TURN_URLS / TURN_STATIC_AUTH_SECRET on the *backend* instead.
#
# This override remains only for local experiments against a TURN server you are
# testing by hand; when set it wins over whatever the backend serves.
# Note getUserMedia only works on localhost or over HTTPS.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
