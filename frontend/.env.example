# Copy to frontend/.env for local (native, non-Docker) development.
VITE_API_BASE_URL=http://localhost:3000

# Optional. ICE servers for study-room audio/video, as a JSON RTCIceServer[].
# Defaults to a public STUN server, which is enough on most networks. Add a
# TURN server for peers behind symmetric NATs (and note that getUserMedia only
# works on localhost or over HTTPS).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
