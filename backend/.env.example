# Copy to backend/.env for local (native, non-Docker) development.
# Assumes `docker compose -f infra/docker-compose.yml up` is running for
# Postgres + MinIO on their default ports below.

DATABASE_URL=postgresql://scholarbase:change_me@localhost:5432/scholarbase
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ALLOWED_EMAIL_DOMAINS=youruniversity.edu.in

# First admin account, created once by `pnpm --filter @scholarbase/backend seed:admin`.
ADMIN_EMAIL=admin@youruniversity.edu.in
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=Site Admin

# Object storage. StorageService (src/modules/storage/storage.service.ts) talks
# to a generic S3-compatible endpoint via the `minio` npm client — despite the
# MINIO_* var names, nothing here is MinIO-specific, so on a host with no
# persistent disk (e.g. Render's free Web Service) these can point at a real S3
# provider instead of a self-hosted MinIO container. For Cloudflare R2 (10GB
# free, zero egress fees):
#   MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
#   MINIO_PORT=443
#   MINIO_USE_SSL=true
#   MINIO_ROOT_USER=<R2 access key id>
#   MINIO_ROOT_PASSWORD=<R2 secret access key>
# Create the R2 API token with bucket read/write (StorageService creates the
# three buckets below on first boot if they don't already exist).
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=scholarbase
MINIO_ROOT_PASSWORD=change_me_min_8_chars
MINIO_BUCKET_PAPERS=papers
MINIO_BUCKET_NOTES=notes
MINIO_BUCKET_AVATARS=avatars

# Only used when running natively / in this Dockerfile's dev target. Hosted
# platforms (Render, etc.) set PORT themselves — don't hardcode it there.
PORT=3000
